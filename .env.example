# AutoTool Studio Configuration Template
# Copy this file to '.env' and fill in your values

# 3 Gemini API keys for backup rotation (Required for subtitle translation and query translation)
GEMINI_API_KEY=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# Brand Channel Name (Optional, used to brand the translated captions)
CHANNEL_NAME=AutoTool Review

# Allow translation fallback if all API keys are exhausted (Optional: true / false)
AUTO_TOOL_ALLOW_TRANSLATION_FALLBACK=false

WHISPER_MODEL_SIZE=small
